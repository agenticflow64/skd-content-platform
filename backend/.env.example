# === PostgreSQL Root ===
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# === Per-Service DB Credentials ===
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=auth_pass
USER_DB_USER=user_svc
USER_DB_PASSWORD=user_pass
INTERACTIONS_DB_USER=interactions
INTERACTIONS_DB_PASSWORD=interactions_pass
SUBSCRIPTION_DB_USER=subscription
SUBSCRIPTION_DB_PASSWORD=subscription_pass
FEED_DB_USER=feed
FEED_DB_PASSWORD=feed_pass

# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379

# === Kafka ===
KAFKA_BROKERS=kafka:9092

# === Shared ===
GATEWAY_HMAC_SECRET=super-secret-hmac-key-for-dev
FRONTEND_URL=http://localhost:3000

# === Auth Service ===
AUTH_DEV_MODE=true

# === SMTP (empty for dev mode) ===
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# === YooKassa ===
YOOKASSA_SHOP_ID=your-shop-id
YOOKASSA_SECRET_KEY=your-secret-key
YOOKASSA_WEBHOOK_DEV_MODE=true

# === External Service URLs (WireMock in dev) ===
REC_SYSTEM_URL=http://wiremock:8080
SERVICES_REC_SYSTEM_URL=http://wiremock:8080
SERVICES_CONTENT_AGGREGATION_URL=http://wiremock:8080
