# ========================================
# Config Service Environment Configuration
# ========================================

# Server Configuration
SERVER_PORT=8081

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=content_agg_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=10
DB_CONNECTION_TIMEOUT=10000
DB_IDLE_TIMEOUT=300000
DB_MAX_LIFETIME=900000

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_SOURCE_CONFIG_UPDATED=source.config.updated
KAFKA_PRODUCER_ACKS=all
KAFKA_PRODUCER_RETRIES=3
KAFKA_PRODUCER_MAX_IN_FLIGHT=1
KAFKA_PRODUCER_IDEMPOTENCE=true
KAFKA_PRODUCER_REQUEST_TIMEOUT=30000
KAFKA_PRODUCER_DELIVERY_TIMEOUT=120000

# Liquibase
LIQUIBASE_CONTEXTS=production

# Management & Monitoring
MANAGEMENT_ENDPOINTS=health,info,metrics,prometheus
MANAGEMENT_HEALTH_DETAILS=always

# Logging
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_KAFKA=INFO
LOG_LEVEL_SQL=false

# Swagger/Springdoc
SWAGGER_ENABLED=true

# jOOQ
JOOQ_FETCH_SIZE=1000
JOOQ_BATCH_SIZE=100
