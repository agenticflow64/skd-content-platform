# ========================================
# Aggregator Service Environment Configuration
# ========================================

# Server Configuration
SERVER_PORT=8086

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=content_agg_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=10
DB_CONNECTION_TIMEOUT=10000
DB_IDLE_TIMEOUT=300000
DB_MAX_LIFETIME=900000

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_CONTENT_PARSED=content.parsed
KAFKA_TOPIC_METRICS_PARSER=metrics.parser
KAFKA_CONSUMER_GROUP_ID=aggregator-service-group
KAFKA_CONSUMER_MAX_POLL_RECORDS=100
KAFKA_CONSUMER_SESSION_TIMEOUT=30000
KAFKA_PRODUCER_ACKS=all
KAFKA_PRODUCER_RETRIES=3
KAFKA_PRODUCER_MAX_IN_FLIGHT=1
KAFKA_PRODUCER_IDEMPOTENCE=true
KAFKA_PRODUCER_REQUEST_TIMEOUT=30000
KAFKA_PRODUCER_DELIVERY_TIMEOUT=120000
KAFKA_LISTENER_CONCURRENCY=4

# Liquibase
LIQUIBASE_CONTEXTS=production

# Management & Monitoring
MANAGEMENT_ENDPOINTS=health,info,metrics,prometheus
MANAGEMENT_HEALTH_DETAILS=always

# Logging
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_KAFKA=INFO
LOG_LEVEL_SQL=false

# Swagger/Springdoc
SWAGGER_ENABLED=true

